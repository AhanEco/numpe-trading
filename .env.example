# =============================================================================
# NUMPE TRADING SOFTWARE - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# Database
# For local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./numpe.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/numpe

# Security
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ADMIN_PASSWORD=change-this-to-a-secure-password

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Market Data API Keys (optional - enhances data coverage)
NEWS_API_KEY=
TWELVE_DATA_API_KEY=

# Update Frequency
UPDATE_INTERVAL_MINUTES=30

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# Deployment
ENVIRONMENT=development
LOG_LEVEL=INFO

